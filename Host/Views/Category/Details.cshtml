@model Application.Dto.CategoryResponseModel

@{
    ViewData["Title"] = "Category Details";
    Layout = "_AdminLayout";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3>Category Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>
