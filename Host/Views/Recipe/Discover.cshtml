@model ICollection<Application.Dto.CreateRecipeResponseModel>

@{
    ViewData["Title"] = "Discover";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            <i class="bi bi-compass text-success"></i>
            Discover
        </h2>

        <p class="text-muted mb-0">
            Discover delicious recipes shared by our community.
        </p>

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Recipe"
                  asp-action="Search"
                  method="get">

                <div class="input-group">

                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="name"
                           class="form-control"
                           placeholder="Search for recipes..." />

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                </div>

            </form>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <span class="text-muted">
                <strong>@(Model?.Count ?? 0)</strong>
                published recipe@(Model?.Count == 1 ? "" : "s")
            </span>

        </div>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var recipe in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6">

                    <div class="card border-0 shadow-sm h-100 overflow-hidden">

                        <div class="position-relative">

                            @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                            {
                                <img src="@recipe.ImageUrl"
                                     class="card-img-top"
                                     alt="@recipe.Name"
                                     style="height:230px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex justify-content-center align-items-center"
                                     style="height:230px;">

                                    <i class="bi bi-image text-muted"
                                       style="font-size:60px;">
                                    </i>

                                </div>
                            }

                            <div class="position-absolute top-0 end-0 m-3">

                                <span class="badge bg-success">

                                    <i class="bi bi-check-circle"></i>
                                    Published

                                </span>

                            </div>

                        </div>


                        <div class="card-body">

                            <h5 class="fw-bold mb-2">

                                @recipe.Name

                            </h5>

                            <p class="text-muted small mb-3">

                                @if (!string.IsNullOrEmpty(recipe.Description))
                                {
                                    if (recipe.Description.Length > 110)
                                    {
                                        @recipe.Description.Substring(0, 110)
                                        <text>...</text>
                                    }
                                    else
                                    {
                                        @recipe.Description
                                    }
                                }

                            </p>

                            <div class="mb-3">

                                @if (recipe.Difficulty.ToString() == "Easy")
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-emoji-smile"></i>
                                        Easy

                                    </span>
                                }
                                else if (recipe.Difficulty.ToString() == "Medium")
                                {
                                    <span class="badge bg-warning text-dark">

                                        <i class="bi bi-dash-circle"></i>
                                        Medium

                                    </span>
                                }
                                else if (recipe.Difficulty.ToString() == "Hard")
                                {
                                    <span class="badge bg-danger">

                                        <i class="bi bi-exclamation-circle"></i>
                                        Hard

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        @recipe.Difficulty

                                    </span>
                                }

                            </div>

                            <div class="row g-2 mb-3">

                                <div class="col-6">

                                    <div class="bg-light rounded p-2">

                                        <small class="text-muted d-block">

                                            <i class="bi bi-hourglass-split"></i>
                                            Preparation

                                        </small>

                                        <strong>
                                            @recipe.PreparationTimeMinutes mins
                                        </strong>

                                    </div>

                                </div>


                                <div class="col-6">

                                    <div class="bg-light rounded p-2">

                                        <small class="text-muted d-block">

                                            <i class="bi bi-fire"></i>
                                            Cooking

                                        </small>

                                        <strong>
                                            @recipe.CookingTimeMinutes mins
                                        </strong>

                                    </div>

                                </div>

                            </div>

                            <div class="d-flex align-items-center mb-3">

                                @if (recipe.IsLiked)
                                {
                                    <span class="text-danger">

                                        <i class="bi bi-heart-fill"></i>

                                        @recipe.LikeCount
                                        @(recipe.LikeCount == 1
                                            ? "Like"
                                            : "Likes")

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">

                                        <i class="bi bi-heart"></i>

                                        @recipe.LikeCount
                                        @(recipe.LikeCount == 1
                                            ? "Like"
                                            : "Likes")

                                    </span>
                                }

                            </div>

                            <a asp-controller="Recipe"
                               asp-action="Details"
                               asp-route-id="@recipe.Id"
                               class="btn btn-success w-100">

                                <i class="bi bi-eye"></i>
                                View Recipe

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-search text-muted"
                   style="font-size:70px;">
                </i>

                <h4 class="fw-bold mt-3">
                    No Recipes Found
                </h4>

                <p class="text-muted">
                    There are currently no published recipes to discover.
                </p>

            </div>

        </div>
    }

</div>