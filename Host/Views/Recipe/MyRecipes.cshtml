@model ICollection<Application.Dto.MyRecipeResponseModel>

@{
    ViewData["Title"] = "My Recipes";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-4">

 
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-journal-text text-success"></i>
                My Recipes
            </h2>

            <p class="text-muted mb-0">
                Manage the recipes you have created.
            </p>
        </div>

        <a asp-controller="Recipe"
           asp-action="Create"
           class="btn btn-success">

            <i class="bi bi-plus-lg"></i>
            Create Recipe

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="mb-3">

        <span class="text-muted">
            You have
            <strong>@(Model?.Count ?? 0)</strong>
            recipe@(Model?.Count == 1 ? "" : "s")
        </span>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var recipe in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6">

                    <div class="card border-0 shadow-sm h-100 overflow-hidden">


                        <div class="position-relative">

                            @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                            {
                                <img src="@recipe.ImageUrl"
                                     class="card-img-top"
                                     alt="@recipe.Name"
                                     style="height:220px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light d-flex justify-content-center align-items-center"
                                     style="height:220px;">

                                    <i class="bi bi-image text-muted"
                                       style="font-size:60px;">
                                    </i>

                                </div>
                            }


                            <div class="position-absolute top-0 end-0 m-3">

                                @if (recipe.Status.ToString() == "Published")
                                {
                                    <span class="badge bg-success">

                                        <i class="bi bi-check-circle"></i>
                                        Published

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        <i class="bi bi-file-earmark"></i>
                                        @recipe.Status

                                    </span>
                                }

                            </div>

                        </div>


                        <div class="card-body">

                            <h5 class="fw-bold mb-2">
                                @recipe.Name
                            </h5>

                            <p class="text-muted small mb-3">

                                @if (!string.IsNullOrEmpty(recipe.Description))
                                {
                                    if (recipe.Description.Length > 100)
                                    {
                                        @recipe.Description.Substring(0, 100)
                                        <text>...</text>
                                    }
                                    else
                                    {
                                        @recipe.Description
                                    }
                                }

                            </p>

                            <div class="mb-3">

                                @switch (recipe.Difficulty.ToString())
                                {
                                    case "Easy":
                                        <span class="badge bg-success">
                                            <i class="bi bi-emoji-smile"></i>
                                            Easy
                                        </span>
                                        break;

                                    case "Medium":
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-dash-circle"></i>
                                            Medium
                                        </span>
                                        break;

                                    case "Hard":
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-circle"></i>
                                            Hard
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-secondary">
                                            @recipe.Difficulty
                                        </span>
                                        break;
                                }

                            </div>


                            <div class="row g-2 mb-3">

                                <div class="col-6">

                                    <div class="bg-light rounded p-2">

                                        <small class="text-muted d-block">
                                            <i class="bi bi-clock"></i>
                                            Preparation
                                        </small>

                                        <strong>
                                            @recipe.PreparationTimeMinutes mins
                                        </strong>

                                    </div>

                                </div>


                                <div class="col-6">

                                    <div class="bg-light rounded p-2">

                                        <small class="text-muted d-block">
                                            <i class="bi bi-fire"></i>
                                            Cooking
                                        </small>

                                        <strong>
                                            @recipe.CookingTimeMinutes mins
                                        </strong>

                                    </div>

                                </div>

                            </div>

                            <div class="d-flex align-items-center mb-3">

                                <span class="text-danger me-3">

                                    <i class="bi bi-heart-fill"></i>

                                    @recipe.LikeCount

                                    @(recipe.LikeCount == 1
                                        ? "Like"
                                        : "Likes")

                                </span>

                            </div>


                            <div class="d-flex gap-2">

                                <a asp-controller="Recipe"
                                   asp-action="Details"
                                   asp-route-id="@recipe.Id"
                                   class="btn btn-outline-success flex-grow-1">

                                    <i class="bi bi-eye"></i>
                                    View

                                </a>


                                <a asp-controller="Recipe"
                                   asp-action="Edit"
                                   asp-route-id="@recipe.Id"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-pencil"></i>

                                </a>


                                <a asp-controller="Recipe"
                                   asp-action="Delete"
                                   asp-route-id="@recipe.Id"
                                   class="btn btn-outline-danger">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="mb-4">

                    <i class="bi bi-journal-x text-muted"
                       style="font-size:80px;">
                    </i>

                </div>

                <h4 class="fw-bold">
                    No Recipes Yet
                </h4>

                <p class="text-muted mb-4">

                    You haven't created any recipes yet.
                    Start sharing your favourite recipes with the community.

                </p>

                <a asp-controller="Recipe"
                   asp-action="Create"
                   class="btn btn-success">

                    <i class="bi bi-plus-lg"></i>
                    Create Your First Recipe

                </a>

            </div>

        </div>
    }

</div>