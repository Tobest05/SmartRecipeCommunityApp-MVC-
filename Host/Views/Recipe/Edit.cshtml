@using Domain.Enum
@model Application.Dto.UpdateRecipeRequestModel

@{
    ViewData["Title"] = "Edit Recipe";
    Layout = "_CustomerLayout";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>Edit Recipe</h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                <input asp-for="Id" hidden />

                <div class="mb-3">

                    <label asp-for="CategoryId" class="form-label"></label>

                    <input asp-for="CategoryId" class="form-control" />

                    <span asp-validation-for="CategoryId" class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Name" class="form-label"></label>

                    <input asp-for="Name" class="form-control" />

                    <span asp-validation-for="Name" class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description" class="form-label"></label>

                    <textarea asp-for="Description"
                              rows="5"
                              class="form-control"></textarea>

                </div>

                <div class="mb-3">

                    <label asp-for="ImageUrl" class="form-label"></label>

                    <input asp-for="ImageUrl" type="file" class="form-control" />

                </div>

                <div class="row">

                    <div class="col-md-6">

                        <label asp-for="PreparationTimeMinutes"></label>

                        <input asp-for="PreparationTimeMinutes"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label asp-for="CookingTimeMinutes"></label>

                        <input asp-for="CookingTimeMinutes"
                               class="form-control" />

                    </div>

                </div>

                <div class="mt-3">

                    <label asp-for="Servings"></label>

                    <input asp-for="Servings"
                           class="form-control" />

                </div>

                <div class="mt-3">

                    <label asp-for="Difficulty"></label>

                    <select asp-for="Difficulty"
                            asp-items="Html.GetEnumSelectList<Difficulty>()"
                            class="form-select">

                        <option value="">Select Difficulty</option>

                    </select>

                </div>

                <div class="mt-3">

                    <label asp-for="Status"></label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<RecipeStatus>()"
                            class="form-select">

                        <option value="">Select Status</option>

                    </select>

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-warning">

                        Update Recipe

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
