@model Application.Dto.UpdateRecipeCommentRequestModel

@{
ViewData["Title"] = "Edit Comment";
Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container py-5"><div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <div class="card border-0 shadow-sm">

            <!-- HEADER -->

            <div class="card-header bg-primary text-white py-3">

                <h4 class="mb-0">

                    <i class="bi bi-pencil-square"></i>

                    Edit Comment

                </h4>

            </div>


            <!-- BODY -->

            <div class="card-body p-4">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">

                        <i class="bi bi-exclamation-circle"></i>

                        @TempData["Error"]

                    </div>
                }


                @if (ViewBag.RecipeName != null)
                {
                    <div class="mb-4">

                        <small class="text-muted">
                            Comment on:
                        </small>

                        <h5 class="fw-bold mb-0">

                            <i class="bi bi-journal-text text-success"></i>

                            @ViewBag.RecipeName

                        </h5>

                    </div>
                }


                <form asp-controller="Comment"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- COMMENT ID -->

                    <input type="hidden"
                           name="id"
                           value="@ViewBag.CommentId" />


                    <!-- RECIPE ID -->

                    <input type="hidden"
                           asp-for="RecipeId" />


                    <!-- COMMENT -->

                    <div class="mb-4">

                        <label asp-for="Comment"
                               class="form-label fw-semibold">

                            Your Comment

                        </label>

                        <textarea asp-for="Comment"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Write your comment..."
                                  required></textarea>

                        <span asp-validation-for="Comment"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BUTTONS -->

                    <div class="d-flex
                                justify-content-between">

                        <a asp-controller="Comment"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left"></i>

                            Back

                        </a>


                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-lg"></i>

                            Save Changes

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

</div>
@section Scripts {

<partial name="_ValidationScriptsPartial" />

}