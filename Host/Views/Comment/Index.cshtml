@model ICollection<Application.Dto.MyCommentViewModel>

@{
    ViewData["Title"] = "My Comments";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- HEADER -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">

            <i class="bi bi-chat-left-text text-primary"></i>

            My Comments

        </h2>

        <p class="text-muted">

            View and manage your comments on recipes.

        </p>

    </div>


    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle"></i>

            @TempData["Success"]

        </div>
    }


    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            <i class="bi bi-exclamation-circle"></i>

            @TempData["Error"]

        </div>
    }


    @if (Model == null || !Model.Any())
    {
        <!-- EMPTY STATE -->

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-chat-left display-1 text-muted"></i>

                <h4 class="fw-bold mt-3">

                    No Comments Yet

                </h4>

                <p class="text-muted">

                    You haven't commented on any recipe yet.

                </p>

                <a asp-controller="Home"
                   asp-action="Feed"
                   class="btn btn-success">

                    <i class="bi bi-compass"></i>

                    Discover Recipes

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- COMMENTS -->

        <div class="row">

            <div class="col-lg-9">

                @foreach (var comment in Model)
                {
                    <div class="card border-0 shadow-sm mb-3">

                        <div class="card-body">

                            <!-- RECIPE HEADER -->

                            <div class="d-flex
                                justify-content-between
                                align-items-start">

                                <div>

                                    <h5 class="fw-bold mb-1">

                                        <i class="bi bi-journal-text text-success"></i>

                                        @comment.RecipeName

                                    </h5>

                                    <small class="text-muted">

                                        <i class="bi bi-calendar3"></i>

                                        @comment.CreatedAt
                                        .ToString("dd MMM yyyy")

                                    </small>

                                </div>


                                <a asp-controller="Recipe"
                                   asp-action="Details"
                                   asp-route-id="@comment.RecipeId"
                                   class="btn btn-sm btn-outline-success">

                                    <i class="bi bi-eye"></i>

                                    View Recipe

                                </a>

                            </div>


                            <hr />


                            <!-- COMMENT -->

                            <div class="bg-light rounded p-3">

                                <div class="d-flex">

                                    <div class="me-3">

                                        <div class="rounded-circle
                                            bg-primary
                                            text-white
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="width:45px;
                                            height:45px;">

                                            <i class="bi bi-person-fill"></i>

                                        </div>

                                    </div>


                                    <div class="flex-grow-1">

                                        <small class="text-muted">

                                            Your comment

                                        </small>

                                        <p class="mb-0 mt-1">

                                            @comment.Comment

                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- ACTION BUTTONS -->

                            <div class="d-flex
                                justify-content-end
                                gap-2
                                mt-3">

                                <a asp-controller="Comment"
                                   asp-action="Edit"
                                   asp-route-id="@comment.Id"
                                   class="btn btn-sm
                                    btn-outline-primary">

                                    <i class="bi bi-pencil"></i>

                                    Edit

                                </a>


                                <form asp-controller="Comment"
                                      asp-action="Delete"
                                      method="post">

                                    @Html.AntiForgeryToken()


                                    <input type="hidden"
                                           name="id"
                                           value="@comment.Id" />


                                    <input type="hidden"
                                           name="recipeId"
                                           value="@comment.RecipeId" />


                                    <button type="submit"
                                            class="btn btn-sm
                                        btn-outline-danger"
                                            onclick="return confirm('Are you sure you want to delete this comment?');">

                                        <i class="bi bi-trash"></i>

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>