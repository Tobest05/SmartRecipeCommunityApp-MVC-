@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SmartRecipe</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

            body {
                background-color: #f8faf9;
            }

            .sidebar {
                width: 250px;
                min-width: 250px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient( 135deg, #198754, #20c997 );
                color: white;
                font-size: 1.3rem;
                box-shadow: 0 4px 12px rgba(25, 135, 84, 0.2);
            }

            .sidebar-link {
                color: #475569 !important;
                border-radius: 12px;
                padding: 11px 13px;
                font-weight: 500;
                transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
            }


                .sidebar-link:hover {
                    background-color: #f0fdf4;
                    color: #198754 !important;
                    transform: translateX(2px);
                }

                .sidebar-link.active {
                    background-color: #198754 !important;
                    color: white !important;
                    box-shadow: 0 4px 12px rgba(25, 135, 84, 0.20);
                }


                    .sidebar-link.active:hover {
                        background-color: #198754 !important;
                        color: white !important;
                        transform: none;
                    }


            .logout-link {
                color: #dc3545 !important;
            }


                .logout-link:hover {
                    background-color: #fff5f5;
                    color: #dc3545 !important;
                }

            .topbar {
                height: 72px;
            }


            .profile-button {
                width: 42px;
                height: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            .notification-button {
                width: 42px;
                height: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
            }


            @@media (max-width: 768px) {

                .sidebar {
                    width: 75px;
                    min-width: 75px;
                    padding: 12px !important;
                }


                    .sidebar .brand-text,
                    .sidebar .nav-text,
                    .sidebar .logout-text {
                        display: none;
                    }


                .sidebar-link {
                    display: flex;
                    justify-content: center;
                    padding: 12px;
                }


                    .sidebar-link i {
                        margin: 0 !important;
                        font-size: 1.2rem;
                    }


                .brand {
                    justify-content: center;
                }
            }

    </style>

</head>
<body>
    <div class="d-flex min-vh-100">

        <aside class="sidebar bg-white border-end p-3 d-flex flex-column">
            
            <div class="mb-4">

                <a asp-controller="Home"
                   asp-action="Feed"
                   class="brand d-flex align-items-center gap-2 text-decoration-none">


                    <div class="brand-icon">

                        <i class="bi bi-egg-fried"></i>

                    </div>


                    <div class="brand-text">

                        <div class="fw-bold text-dark fs-5">
                            SmartRecipe
                        </div>

                        <small class="text-muted">
                            Cook. Discover. Share.
                        </small>

                    </div>


                </a>

            </div>

            <nav class="nav flex-column gap-1">


                <a asp-controller="Home"
                   asp-action="Feed"
                   class="sidebar-link nav-link
                    @(currentController == "Home" &&
                     currentAction == "Feed"
                         ? "active"
                         : "")">

                    <i class="bi bi-house-fill me-3"></i>

                    <span class="nav-text">
                        Home
                    </span>

                </a>

                <a asp-controller="Recipe"
                   asp-action="MyRecipes"
                   class="sidebar-link nav-link
                    @(currentController == "Recipe" &&
                     currentAction == "MyRecipes"
                         ? "active"
                         : "")">

                    <i class="bi bi-journal-text me-3"></i>

                    <span class="nav-text">
                        My Recipes
                    </span>

                </a>

                <a asp-controller="Recipe"
                   asp-action="Discover"
                   class="sidebar-link nav-link
                    @(currentController == "Recipe" &&
                     currentAction == "Discover"
                         ? "active"
                         : "")">

                    <i class="bi bi-compass-fill me-3"></i>

                    <span class="nav-text">
                        Discover
                    </span>

                </a>


                <a asp-controller="FavouriteRecipe"
                   asp-action="Index"
                   class="sidebar-link nav-link
                    @(currentController == "FavouriteRecipe"
                         ? "active"
                         : "")">

                    <i class="bi bi-heart-fill me-3"></i>

                    <span class="nav-text">
                        Favorites
                    </span>

                </a>


                <a asp-controller="Comment"
                   asp-action="Index"
                   class="sidebar-link nav-link
                    @(currentController == "Comment"
                         ? "active"
                         : "")">

                    <i class="bi bi-chat-left-text-fill me-3"></i>

                    <span class="nav-text">
                        Comments
                    </span>

                </a>

                <a asp-controller="RecipeRating"
                   asp-action="MyRatings"
                   class="sidebar-link nav-link
                    @(currentController == "RecipeRating"
                         ? "active"
                         : "")">

                    <i class="bi bi-star-fill me-3"></i>

                    <span class="nav-text">
                        Ratings
                    </span>

                </a>

                <a asp-controller="Customer"
                   asp-action="Profile"
                   class="sidebar-link nav-link
                    @(currentController == "Customer"
                         ? "active"
                         : "")">

                    <i class="bi bi-person-fill me-3"></i>

                    <span class="nav-text">
                        Profile
                    </span>

                </a>


            </nav>


            <div class="mt-auto">


                <hr class="text-muted" />


                <a asp-controller="Account"
                   asp-action="Logout"
                   class="sidebar-link logout-link nav-link">


                    <i class="bi bi-box-arrow-right me-3"></i>


                    <span class="logout-text">
                        Logout
                    </span>


                </a>


            </div>


        </aside>


        <div class="flex-grow-1">


            <nav class="topbar navbar bg-white border-bottom px-4">


                <div class="container-fluid px-0">


                    <div>

                        <span class="fw-semibold text-dark">
                            @ViewData["Title"]
                        </span>

                    </div>

                    <div class="d-flex align-items-center gap-2">

                        <button type="button"
                                class="btn btn-light notification-button">

                            <i class="bi bi-bell text-secondary"></i>

                        </button>


                        <a asp-controller="Customer"
                           asp-action="Profile"
                           class="btn btn-success rounded-circle profile-button">

                            <i class="bi bi-person-fill"></i>

                        </a>


                    </div>


                </div>


            </nav>


            <main class="p-3 p-md-4">

                @RenderBody()

            </main>


        </div>

    </div> 
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body></html>