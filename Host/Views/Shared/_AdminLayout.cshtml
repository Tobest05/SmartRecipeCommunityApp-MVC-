<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - SmartRecipe</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body style="background:#f4f7fb;">

    <div class="d-flex">

        

        <aside class="sidebar">

            <div class="text-center py-4">

                <i class="bi bi-egg-fried display-4 text-warning"></i>

                <h3 class="fw-bold text-white mt-2">

                    SmartRecipe

                </h3>

                <small class="text-light">

                    Admin Panel

                </small>

            </div>

            <nav class="nav flex-column">

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="nav-link">

                    <i class="bi bi-speedometer2 me-2"></i>

                    Dashboard

                </a>

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="nav-link">

                    <i class="bi bi-people me-2"></i>

                    Customers

                </a>

                <a asp-controller="Recipe"
                   asp-action="Index"
                   class="nav-link">

                    <i class="bi bi-journal-richtext me-2"></i>

                    Recipes

                </a>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="nav-link">

                    <i class="bi bi-grid me-2"></i>

                    Categories

                </a>

                <a asp-controller="Comment"
                   asp-action="Index"
                   class="nav-link">

                    <i class="bi bi-chat-left-text me-2"></i>

                    Comments

                </a>

                <a asp-controller="Rating"
                   asp-action="Index"
                   class="nav-link">

                    <i class="bi bi-star me-2"></i>

                    Ratings

                </a>

                <hr class="text-secondary" />

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="nav-link text-danger">

                    <i class="bi bi-box-arrow-right me-2"></i>

                    Logout

                </a>

            </nav>

        </aside>

        

        <div class="content flex-grow-1">

            

            <nav class="navbar bg-white shadow-sm rounded-4 px-4 py-3 mb-4">

                <h4 class="fw-bold mb-0">

                    @ViewData["Title"]

                </h4>

                <div class="d-flex align-items-center">

                    <button class="btn position-relative me-4">

                        <i class="bi bi-bell-fill fs-4"></i>

                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">

                            3

                        </span>

                    </button>

                    <img src="https://i.pravatar.cc/50"
                         class="rounded-circle border border-success"
                         width="45"
                         height="45" />

                </div>

            </nav>

            @RenderBody()

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>