@model Application.Dto.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<h2 class="mb-4">Admin Dashboard</h2>

<div class="row g-4 mb-5">

    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow bg-primary text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Customers</h6>
                    <h2>@Model.TotalCustomers</h2>
                </div>
                <i class="bi bi-people-fill display-5"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow bg-success text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Recipes</h6>
                    <h2>@Model.TotalRecipes</h2>
                </div>
                <i class="bi bi-journal-richtext display-5"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow bg-warning text-dark">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Categories</h6>
                    <h2>@Model.TotalCategories</h2>
                </div>
                <i class="bi bi-grid-fill display-5"></i>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card border-0 shadow bg-danger text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Comments</h6>
                    <h2>@Model.TotalComments</h2>
                </div>
                <i class="bi bi-chat-left-text-fill display-5"></i>
            </div>
        </div>
    </div>

</div>

<div class="row mb-5">

    <div class="col-lg-4">

        <div class="card border-0 shadow">

            <div class="card-body text-center">

                <h5>Total Ratings</h5>

                <h1 class="text-warning">

                    @Model.TotalRatings

                </h1>

                <i class="bi bi-star-fill text-warning display-4"></i>

            </div>

        </div>

    </div>

</div>

<div class="card shadow border-0">

    <div class="card-header bg-success text-white">

        <h4 class="mb-0">

            Recent Recipes

        </h4>

    </div>

    <div class="card-body">

        @if (Model.RecentRecipes.Any())
        {
            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Image</th>
                        <th>Name</th>
                        <th>Difficulty</th>
                        <th>Status</th>
                        <th>Preparation</th>
                        <th>Cooking</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var recipe in Model.RecentRecipes)
                    {
                        <tr>

                            <td>
                                <img src="@recipe.ImageUrl"
                                     width="70"
                                     height="70"
                                     class="rounded" />
                            </td>

                            <td>@recipe.Name</td>

                            <td>
                                <span class="badge bg-primary">
                                    @recipe.Difficulty
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    @recipe.Status
                                </span>
                            </td>

                            <td>@recipe.PreparationTimeMinutes minutes</td>

                            <td>@recipe.CookingTimeMinutes mins</td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="alert alert-info">

                No recipes available.

            </div>
        }

    </div>

</div>