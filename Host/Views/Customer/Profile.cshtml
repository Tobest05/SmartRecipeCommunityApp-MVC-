\@using Application.Dto
@model RegisterCustomerResponse

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3
        mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="text-success">
                    <i class="bi bi-person-circle"></i>
                </span>

                <span class="text-success fw-semibold small">
                    ACCOUNT
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-1">
                My Profile
            </h2>

            <p class="text-muted mb-0">
                Manage your personal information and profile.
            </p>
        </div>

        <a asp-controller="Customer"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-success px-4">

            <i class="bi bi-pencil-square me-2"></i>
            Edit Profile

        </a>

    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="position-relative"
             style="height: 190px;
            background: linear-gradient(135deg, #198754, #20c997, #0f766e);">

            <div class="position-absolute rounded-circle bg-white opacity-10"
                 style="width: 250px; height: 250px; right: -70px; top: -120px;">
            </div>

            <div class="position-absolute rounded-circle bg-white opacity-10"
                 style="width: 180px; height: 180px; left: -70px; bottom: -100px;">
            </div>

            <div class="position-absolute bottom-0 start-0 p-4 text-white">

                <div class="d-flex align-items-center gap-2">

                    <i class="bi bi-stars"></i>

                    <span class="small fw-semibold">
                        SmartRecipe Member
                    </span>

                </div>

            </div>

        </div>


        <div class="card-body px-4 px-lg-5 pb-5">

            <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-end">

                <div class="position-relative"
                     style="margin-top: -75px;">

                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl"
                             alt="Profile Image"
                             class="rounded-4 border border-5 border-white shadow"
                             style="width: 150px;
                        height: 150px;
                        object-fit: cover;
                        background-color: white;" />
                    }
                    else
                    {
                        <div class="rounded-4 border border-5 border-white shadow
                            bg-success-subtle
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width: 150px;
                            height: 150px;">

                            <i class="bi bi-person-fill text-success"
                               style="font-size: 4.5rem;">
                            </i>

                        </div>
                    }

                    <span class="position-absolute
                        bottom-0
                        end-0
                        translate-middle
                        p-2
                        bg-success
                        border border-3 border-white
                        rounded-circle">
                    </span>

                </div>

                <div class="mt-3 mt-md-0">

                    <a asp-controller="Customer"
                       asp-action="Dashboard"
                       class="btn btn-light border px-4">

                        <i class="bi bi-arrow-left me-2"></i>
                        Dashboard

                    </a>

                </div>

            </div>

            <div class="mt-4">

                <div class="d-flex flex-column flex-md-row
                    align-items-md-center
                    gap-2">

                    <h1 class="fw-bold mb-0 text-dark">
                        @Model.FirstName @Model.LastName
                    </h1>

                    <span class="badge rounded-pill
                        text-success
                        bg-success-subtle
                        px-3 py-2">

                        <i class="bi bi-patch-check-fill me-1"></i>
                        Member

                    </span>

                </div>


                <div class="d-flex align-items-center
                    text-muted
                    mt-2">

                    <i class="bi bi-envelope me-2"></i>

                    <span>
                        @Model.Email
                    </span>

                </div>

            </div>


            <hr class="my-4">

            <div class="mb-4">

                <div class="d-flex align-items-center gap-3 mb-4">

                    <div class="rounded-3
                        bg-success-subtle
                        text-success
                        d-flex
                        align-items-center
                        justify-content-center"
                         style="width: 45px; height: 45px;">

                        <i class="bi bi-person-vcard fs-5"></i>

                    </div>

                    <div>

                        <h5 class="fw-bold mb-1">
                            Personal Information
                        </h5>

                        <p class="text-muted small mb-0">
                            Your basic account information
                        </p>

                    </div>

                </div>


                <div class="row g-3">


                    <div class="col-md-6">

                        <div class="bg-light rounded-4 p-4 h-100">

                            <div class="d-flex align-items-start gap-3">

                                <div class="rounded-3
                                    bg-white
                                    shadow-sm
                                    text-success
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    flex-shrink-0"
                                     style="width: 42px; height: 42px;">

                                    <i class="bi bi-person"></i>

                                </div>

                                <div>

                                    <small class="text-muted
                                        text-uppercase
                                        fw-semibold">

                                        First Name

                                    </small>

                                    <div class="fw-semibold
                                        text-dark
                                        mt-1">

                                        @Model.FirstName

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="bg-light rounded-4 p-4 h-100">

                            <div class="d-flex align-items-start gap-3">

                                <div class="rounded-3
                                    bg-white
                                    shadow-sm
                                    text-success
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    flex-shrink-0"
                                     style="width: 42px; height: 42px;">

                                    <i class="bi bi-person"></i>

                                </div>

                                <div>

                                    <small class="text-muted
                                        text-uppercase
                                        fw-semibold">

                                        Last Name

                                    </small>

                                    <div class="fw-semibold
                                        text-dark
                                        mt-1">

                                        @Model.LastName

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="bg-light rounded-4 p-4 h-100">

                            <div class="d-flex align-items-start gap-3">

                                <div class="rounded-3
                                    bg-white
                                    shadow-sm
                                    text-success
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    flex-shrink-0"
                                     style="width: 42px; height: 42px;">

                                    <i class="bi bi-envelope"></i>

                                </div>

                                <div class="w-100">

                                    <small class="text-muted
                                        text-uppercase
                                        fw-semibold">

                                        Email Address

                                    </small>

                                    <div class="fw-semibold
                                        text-dark
                                        mt-1
                                        text-break">

                                        @Model.Email

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="bg-light rounded-4 p-4 h-100">

                            <div class="d-flex align-items-start gap-3">

                                <div class="rounded-3
                                    bg-white
                                    shadow-sm
                                    text-success
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    flex-shrink-0"
                                     style="width: 42px; height: 42px;">

                                    <i class="bi bi-chat-quote"></i>

                                </div>

                                <div>

                                    <small class="text-muted
                                        text-uppercase
                                        fw-semibold">

                                        Bio

                                    </small>

                                    <div class="text-dark mt-1">

                                        @(string.IsNullOrWhiteSpace(Model.Bio)
                                            ? "No bio added yet."
                                            : Model.Bio)

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="mt-4">

                <div class="rounded-4
                    p-4
                    border
                    border-success-subtle
                    bg-success-subtle">

                    <div class="d-flex align-items-start gap-3">

                        <div class="rounded-3
                            bg-white
                            text-success
                            d-flex
                            align-items-center
                            justify-content-center
                            flex-shrink-0"
                             style="width: 42px; height: 42px;">

                            <i class="bi bi-heart-fill"></i>

                        </div>

                        <div>

                            <h6 class="fw-bold text-dark mb-1">
                                Make your profile yours
                            </h6>

                            <p class="text-muted small mb-0">
                                Add a profile photo and bio so other
                                food lovers can get to know you better.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <div class="d-flex flex-column
                flex-sm-row
                gap-2
                mt-4">

                <a asp-controller="Customer"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-success px-4">

                    <i class="bi bi-pencil-square me-2"></i>
                    Edit Profile

                </a>

                <a asp-controller="Customer"
                   asp-action="Dashboard"
                   class="btn btn-outline-secondary px-4">

                    <i class="bi bi-speedometer2 me-2"></i>
                    Go to Dashboard

                </a>

            </div>

        </div>

    </div>

</div>