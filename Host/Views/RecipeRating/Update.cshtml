@model Application.Dto.UpdateRecipeRatingRequestModel

@{
    ViewData["Title"] = "Edit Rating";
    Layout = "_CustomerLayout";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>Edit Rating</h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input asp-for="Id" hidden />

                <div class="mb-3">

                    <label asp-for="RecipeId"></label>

                    <input asp-for="RecipeId"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Rating"></label>

                    <input asp-for="Rating"
                           type="number"
                           min="1"
                           max="5"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Review"></label>

                    <textarea asp-for="Review"
                              rows="5"
                              class="form-control"></textarea>

                </div>

                <button class="btn btn-warning">

                    Update

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>