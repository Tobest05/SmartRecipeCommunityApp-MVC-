@model Application.Dto.FavouriteRecipeResponseModel

@{
    ViewData["Title"] = "Remove Favourite";
    Layout = "_CustomerLayout";
}

<div class="container mt-5">

    <div class="card border-danger shadow">

        <div class="card-header bg-danger text-white">

            <h3>Remove Favourite Recipe</h3>

        </div>

        <div class="card-body">

            <h5>

                Are you sure you want to remove this recipe from your favourites?

            </h5>

            <hr />

            <p>

                <strong>Recipe Id:</strong>

                @Model.RecipeId

            </p>

            <form asp-action="Delete"
                  method="post">

                <input asp-for="RecipeId"
                       hidden />

                <button type="submit"
                        class="btn btn-danger">

                    Remove

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>
