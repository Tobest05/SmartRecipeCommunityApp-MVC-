@model Application.Dto.CreateFavouriteRecipeRequestModel

@{
    ViewData["Title"] = "Add Favourite Recipe";
    Layout = "_CustomerLayout";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>Add Favourite Recipe</h3>

        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                <div class="mb-3">

                    <label asp-for="RecipeId"></label>

                    <input asp-for="RecipeId"
                           class="form-control" />

                </div>

                <button type="submit"
                        class="btn btn-success">

                    Save

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>
