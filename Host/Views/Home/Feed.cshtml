@model ICollection<Application.Dto.CreateRecipeResponseModel>

@{
    ViewData["Title"] = "Home";
    Layout = "_CustomerLayout";
}

<div class="container-fluid">

    <div class="text-center mb-4">

        <h2 class="fw-bold">
            Discover Recipes
        </h2>

        <p class="text-muted">
            Discover delicious recipes shared by our community.
        </p>

    </div>


    @if (Model == null || !Model.Any())
    {

        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <i class="bi bi-journal-x display-4 text-muted"></i>

                <h4 class="mt-3">
                    No recipes yet
                </h4>

                <p class="text-muted">
                    There are no published recipes at the moment.
                </p>

                <a asp-controller="Recipe"
                   asp-action="Create"
                   class="btn btn-success">

                    <i class="bi bi-plus-circle"></i>
                    Create Recipe

                </a>

            </div>

        </div>
    }
    else
    {

        <div class="row justify-content-center">

            <div class="col-lg-8 col-md-10">

                @foreach (var recipe in Model)
                {
                    <div class="card shadow-sm border-0 mb-4">

                        <!-- Recipe Image -->
                        @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                        {
                            <img src="@recipe.ImageUrl"
                                 class="card-img-top"
                                 style="height:350px; object-fit:cover;"
                                 alt="@recipe.Name" />
                        }
                        else
                        {
                            <div class="bg-light d-flex justify-content-center align-items-center"
                                 style="height:350px;">

                                <i class="bi bi-image display-3 text-muted"></i>

                            </div>
                        }



                        <div class="card-body">


                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <h4 class="card-title fw-bold mb-0">

                                    @recipe.Name

                                </h4>

                                <span class="badge bg-success">

                                    @recipe.Difficulty

                                </span>

                            </div>

                            <p class="card-text text-muted">

                                @recipe.Description

                            </p>



                            <div class="d-flex flex-wrap gap-3 text-muted mb-3">

                                <span>
                                    <i class="bi bi-clock text-success"></i>

                                    @(recipe.PreparationTimeMinutes + recipe.CookingTimeMinutes) mins
                                </span>

                                <span>
                                    <i class="bi bi-people text-success"></i>

                                    @recipe.Servings servings
                                </span>

                            </div>


                            <hr />


                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <span class="me-3">

                                        <i class="bi bi-heart text-danger"></i>

                                        @recipe.LikeCount

                                    </span>


                                    <span class="me-3">

                                        <i class="bi bi-star-fill text-warning"></i>

                                        Rating

                                    </span>

                                </div>


                                <a asp-controller="Recipe"
                                   asp-action="Details"
                                   asp-route-id="@recipe.Id"
                                   class="btn btn-success">

                                    View Recipe

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>