@{
    ViewData["Title"] = "Smart Recipe";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Smart Recipe | Discover. Create. Share.</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg landing-navbar fixed-top">
        <div class="container px-lg-4">

            <a class="navbar-brand premium-brand"
               asp-controller="Home"
               asp-action="Index">

                <span class="brand-icon">
                    <i class="fa-solid fa-utensils"></i>
                </span>

                <span>
                    Smart<span class="brand-accent">Recipe</span>
                </span>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav mx-auto premium-nav">

                    <li class="nav-item">
                        <a class="nav-link active" href="#home">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#categories">Categories</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#recipes">Recipes</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>

                </ul>

                <div class="d-flex align-items-center gap-2 navbar-actions">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-login">
                        Sign In
                    </a>

                    <a asp-controller="Customer"
                       asp-action="Register"
                       class="btn btn-orange">
                        Get Started
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>

                </div>

            </div>
        </div>
    </nav>


    <main>


        <section id="home" class="hero-section">

            <div class="hero-glow hero-glow-one"></div>
            <div class="hero-glow hero-glow-two"></div>

            <div class="container px-lg-4">

                <div class="row align-items-center hero-row">

                    <div class="col-lg-6 hero-content">

                        <div class="hero-badge">
                            <span class="badge-dot"></span>
                            <i class="fa-solid fa-fire"></i>
                            Discover • Create • Share
                        </div>

                        <h1 class="hero-title">
                            Cook something
                            <span>extraordinary.</span>
                        </h1>

                        <p class="hero-text">
                            Discover inspiring recipes, create your own culinary
                            masterpieces and connect with a community that
                            genuinely loves good food.
                        </p>

                        <div class="hero-buttons">

                            <a asp-controller="Recipe"
                               asp-action="Index"
                               class="btn btn-orange btn-lg premium-button">

                                Explore Recipes
                                <i class="fa-solid fa-arrow-right ms-2"></i>

                            </a>

                            <a asp-controller="Customer"
                               asp-action="Register"
                               class="btn btn-outline-light btn-lg premium-outline-button">

                                <i class="fa-solid fa-user-plus me-2"></i>
                                Join Community

                            </a>

                        </div>

                        <div class="hero-trust">

                            <div class="user-stack">

                                <span><i class="fa-solid fa-user"></i></span>
                                <span><i class="fa-solid fa-user"></i></span>
                                <span><i class="fa-solid fa-user"></i></span>
                                <span><i class="fa-solid fa-user"></i></span>
                                <span class="user-stack-more">+</span>

                            </div>

                            <div class="trust-copy">

                                <div class="trust-stars">
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                    <i class="fa-solid fa-star"></i>
                                </div>

                                <strong>5,000+ food lovers</strong>

                                <small>
                                    cooking, sharing & discovering
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="col-lg-6 hero-visual">

                        <div class="hero-orbit"></div>

                        <div class="hero-image-circle">

                            <div class="hero-image-inner">

                                <img src="~/Images/Hero.jpg"
                                     class="hero-image"
                                     alt="Delicious meal prepared by a chef">

                            </div>

                        </div>


                        <div class="floating-card floating-rating">

                            <div class="floating-icon">
                                <i class="fa-solid fa-star"></i>
                            </div>

                            <div>
                                <span class="floating-label">
                                    Community Rating
                                </span>

                                <strong>4.9 / 5</strong>
                            </div>

                        </div>


                        <div class="floating-card floating-recipes">

                            <div class="floating-icon orange-icon">
                                <i class="fa-solid fa-utensils"></i>
                            </div>

                            <div>
                                <span class="floating-label">
                                    Recipes Available
                                </span>

                                <strong>10K+</strong>
                            </div>

                        </div>


                        <div class="floating-mini-card">
                            <i class="fa-solid fa-heart"></i>
                            <span>Loved by foodies</span>
                        </div>

                    </div>

                </div>

            </div>

            <div class="hero-scroll">
                <span>Scroll to explore</span>
                <i class="fa-solid fa-arrow-down"></i>
            </div>

        </section>

        <section class="stats-section">

            <div class="container">

                <div class="stats-wrapper">

                    <div class="stat-item">

                        <span class="stat-icon">
                            <i class="fa-solid fa-bowl-food"></i>
                        </span>

                        <div>
                            <h2>10K+</h2>
                            <p>Recipes</p>
                        </div>

                    </div>


                    <div class="stat-divider"></div>


                    <div class="stat-item">

                        <span class="stat-icon">
                            <i class="fa-solid fa-users"></i>
                        </span>

                        <div>
                            <h2>5K+</h2>
                            <p>Food Lovers</p>
                        </div>

                    </div>


                    <div class="stat-divider"></div>


                    <div class="stat-item">

                        <span class="stat-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>

                        <div>
                            <h2>250+</h2>
                            <p>Categories</p>
                        </div>

                    </div>


                    <div class="stat-divider"></div>


                    <div class="stat-item">

                        <span class="stat-icon">
                            <i class="fa-solid fa-star"></i>
                        </span>

                        <div>
                            <h2>15K+</h2>
                            <p>Reviews</p>
                        </div>

                    </div>

                </div>

            </div>

        </section>



        <section id="features" class="section-padding features-section">

            <div class="container">

                <div class="section-heading text-center">

                    <span class="section-label">
                        WHY SMART RECIPE
                    </span>

                    <h2>
                        Everything you need to
                        <span>cook better.</span>
                    </h2>

                    <p>
                        A beautifully simple place to discover recipes,
                        save inspiration and share your passion for food.
                    </p>

                </div>


                <div class="row g-4 mt-5">

                    <div class="col-md-6 col-lg-4">

                        <div class="feature-card premium-card">

                            <div class="feature-top">
                                <span class="feature-number">01</span>

                                <div class="feature-icon orange">
                                    <i class="fa-solid fa-compass"></i>
                                </div>
                            </div>

                            <h4>Discover Recipes</h4>

                            <p>
                                Explore carefully organized recipes across
                                different cuisines, occasions and categories.
                            </p>

                            <span class="feature-link">
                                Explore
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <div class="feature-card premium-card">

                            <div class="feature-top">
                                <span class="feature-number">02</span>

                                <div class="feature-icon red">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </div>
                            </div>

                            <h4>Create & Share</h4>

                            <p>
                                Turn your favourite meals into recipes and
                                share your creations with the community.
                            </p>

                            <span class="feature-link">
                                Start creating
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <div class="feature-card premium-card">

                            <div class="feature-top">
                                <span class="feature-number">03</span>

                                <div class="feature-icon yellow">
                                    <i class="fa-solid fa-heart"></i>
                                </div>
                            </div>

                            <h4>Save Favorites</h4>

                            <p>
                                Build your personal collection of recipes
                                you never want to lose.
                            </p>

                            <span class="feature-link">
                                Save inspiration
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <div class="feature-card premium-card">

                            <div class="feature-top">
                                <span class="feature-number">04</span>

                                <div class="feature-icon purple">
                                    <i class="fa-solid fa-star"></i>
                                </div>
                            </div>

                            <h4>Rate Recipes</h4>

                            <p>
                                Share your experience and help others discover
                                meals worth trying.
                            </p>

                            <span class="feature-link">
                                Share your thoughts
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <div class="feature-card premium-card">

                            <div class="feature-top">
                                <span class="feature-number">05</span>

                                <div class="feature-icon blue">
                                    <i class="fa-solid fa-book-open"></i>
                                </div>
                            </div>

                            <h4>Easy Instructions</h4>

                            <p>
                                Follow clear, practical instructions designed
                                to make cooking feel effortless.
                            </p>

                            <span class="feature-link">
                                Cook with confidence
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <div class="feature-card premium-card">

                            <div class="feature-top">
                                <span class="feature-number">06</span>

                                <div class="feature-icon green">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                            </div>

                            <h4>Food Community</h4>

                            <p>
                                Meet people who share your passion for cooking,
                                food and discovering new flavours.
                            </p>

                            <span class="feature-link">
                                Meet the community
                                <i class="fa-solid fa-arrow-right"></i>
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <section id="categories" class="section-padding categories-section">

            <div class="container">

                <div class="section-heading text-center">

                    <span class="section-label">
                        EXPLORE
                    </span>

                    <h2>
                        Find something
                        <span>delicious.</span>
                    </h2>

                    <p>
                        From your first meal of the day to something sweet
                        after dinner, there is always something to discover.
                    </p>

                </div>


                <div class="row g-4 mt-5">

                    <div class="col-md-6 col-lg-4">

                        <a href="#" class="category-card premium-category">

                            <img src="~/Images/Breakfast.jpg"
                                 alt="Breakfast">

                            <div class="category-overlay">

                                <span class="category-icon">
                                    <i class="fa-solid fa-mug-hot"></i>
                                </span>

                                <div>
                                    <h4>Breakfast</h4>
                                    <p>Start your day right</p>
                                </div>

                                <span class="category-arrow">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </span>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <a href="#" class="category-card premium-category">

                            <img src="~/Images/Lunch.jpg"
                                 alt="Lunch">

                            <div class="category-overlay">

                                <span class="category-icon">
                                    <i class="fa-solid fa-burger"></i>
                                </span>

                                <div>
                                    <h4>Lunch</h4>
                                    <p>Midday favorites</p>
                                </div>

                                <span class="category-arrow">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </span>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <a href="#" class="category-card premium-category">

                            <img src="~/Images/Dinner.jpg"
                                 alt="Dinner">

                            <div class="category-overlay">

                                <span class="category-icon">
                                    <i class="fa-solid fa-pizza-slice"></i>
                                </span>

                                <div>
                                    <h4>Dinner</h4>
                                    <p>End your day deliciously</p>
                                </div>

                                <span class="category-arrow">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </span>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <a href="#" class="category-card premium-category">

                            <img src="~/Images/Dessert.jpg"
                                 alt="Desserts">

                            <div class="category-overlay">

                                <span class="category-icon">
                                    <i class="fa-solid fa-cake-candles"></i>
                                </span>

                                <div>
                                    <h4>Desserts</h4>
                                    <p>Something beautifully sweet</p>
                                </div>

                                <span class="category-arrow">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </span>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <a href="#" class="category-card premium-category">

                            <img src="~/Images/Drinks.jpg"
                                 alt="Drinks">

                            <div class="category-overlay">

                                <span class="category-icon">
                                    <i class="fa-solid fa-martini-glass"></i>
                                </span>

                                <div>
                                    <h4>Drinks</h4>
                                    <p>Refreshingly good</p>
                                </div>

                                <span class="category-arrow">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </span>

                            </div>

                        </a>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <a href="#" class="category-card premium-category">

                            <img src="~/Images/Snacks.jpg"
                                 alt="Snacks">

                            <div class="category-overlay">

                                <span class="category-icon">
                                    <i class="fa-solid fa-cookie-bite"></i>
                                </span>

                                <div>
                                    <h4>Snacks</h4>
                                    <p>Perfect little bites</p>
                                </div>

                                <span class="category-arrow">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </span>

                            </div>

                        </a>

                    </div>

                </div>

            </div>

        </section>

        <section id="recipes" class="section-padding recipes-section">

            <div class="container">

                <div class="section-heading recipe-heading">

                    <div>

                        <span class="section-label">
                            COMMUNITY FAVORITES
                        </span>

                        <h2>
                            Recipes people
                            <span>love.</span>
                        </h2>

                        <p>
                            Discover dishes our community keeps coming back to.
                        </p>

                    </div>

                    <a asp-controller="Recipe"
                       asp-action="Index"
                       class="btn btn-outline-orange">

                        View All Recipes
                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>

                </div>


                <div class="row g-4 mt-4">

                    <div class="col-md-6 col-lg-4">

                        <article class="recipe-card premium-recipe-card">

                            <div class="recipe-image">

                                <img src="~/Images/Recipe.jpg"
                                     alt="Fluffy Pancakes">

                                <span class="recipe-category">
                                    Breakfast
                                </span>

                                <button type="button"
                                        class="favorite-button"
                                        aria-label="Save Fluffy Pancakes">

                                    <i class="fa-regular fa-heart"></i>

                                </button>

                            </div>

                            <div class="recipe-body">

                                <div class="recipe-rating-row">

                                    <div class="rating">
                                        <i class="fa-solid fa-star"></i>
                                        <strong>4.9</strong>
                                        <span>(128)</span>
                                    </div>

                                    <span class="recipe-level">
                                        Easy
                                    </span>

                                </div>

                                <h4>Fluffy Pancakes</h4>

                                <p>
                                    Soft, golden and deliciously fluffy
                                    pancakes for the perfect morning.
                                </p>

                                <div class="recipe-meta">

                                    <span>
                                        <i class="fa-regular fa-clock"></i>
                                        25 mins
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-utensils"></i>
                                        8 ingredients
                                    </span>

                                </div>

                            </div>

                        </article>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <article class="recipe-card premium-recipe-card">

                            <div class="recipe-image">

                                <img src="~/Images/Recipe2.jpg"
                                     alt="Crispy Chicken Burger">

                                <span class="recipe-category">
                                    Lunch
                                </span>

                                <button type="button"
                                        class="favorite-button"
                                        aria-label="Save Crispy Chicken Burger">

                                    <i class="fa-regular fa-heart"></i>

                                </button>

                            </div>

                            <div class="recipe-body">

                                <div class="recipe-rating-row">

                                    <div class="rating">
                                        <i class="fa-solid fa-star"></i>
                                        <strong>4.8</strong>
                                        <span>(96)</span>
                                    </div>

                                    <span class="recipe-level">
                                        Medium
                                    </span>

                                </div>

                                <h4>Crispy Chicken Burger</h4>

                                <p>
                                    A golden crispy chicken burger paired
                                    with perfectly seasoned fries.
                                </p>

                                <div class="recipe-meta">

                                    <span>
                                        <i class="fa-regular fa-clock"></i>
                                        40 mins
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-utensils"></i>
                                        12 ingredients
                                    </span>

                                </div>

                            </div>

                        </article>

                    </div>


                    <div class="col-md-6 col-lg-4">

                        <article class="recipe-card premium-recipe-card">

                            <div class="recipe-image">

                                <img src="~/Images/Recipe3.jpg"
                                     alt="Nigerian Jollof Rice">

                                <span class="recipe-category">
                                    Dinner
                                </span>

                                <button type="button"
                                        class="favorite-button"
                                        aria-label="Save Nigerian Jollof Rice">

                                    <i class="fa-regular fa-heart"></i>

                                </button>

                            </div>

                            <div class="recipe-body">

                                <div class="recipe-rating-row">

                                    <div class="rating">
                                        <i class="fa-solid fa-star"></i>
                                        <strong>5.0</strong>
                                        <span>(214)</span>
                                    </div>

                                    <span class="recipe-level">
                                        Medium
                                    </span>

                                </div>

                                <h4>Nigerian Jollof Rice</h4>

                                <p>
                                    Rich, smoky and flavour-packed Nigerian
                                    Jollof Rice made for sharing.
                                </p>

                                <div class="recipe-meta">

                                    <span>
                                        <i class="fa-regular fa-clock"></i>
                                        1 hour
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-utensils"></i>
                                        14 ingredients
                                    </span>

                                </div>

                            </div>

                        </article>

                    </div>

                </div>

            </div>

        </section>

        <section class="how-section section-padding">

            <div class="how-glow"></div>

            <div class="container position-relative">

                <div class="section-heading text-center text-white">

                    <span class="section-label light">
                        SIMPLE & EASY
                    </span>

                    <h2>
                        From inspiration to
                        <span>your table.</span>
                    </h2>

                    <p>
                        Everything you need is just a few clicks away.
                    </p>

                </div>


                <div class="row g-4 mt-5">

                    <div class="col-md-6 col-lg-3">

                        <div class="step-card">

                            <div class="step-number">01</div>

                            <div class="step-icon">
                                <i class="fa-solid fa-user-plus"></i>
                            </div>

                            <h4>Create an Account</h4>

                            <p>
                                Sign up and become part of the Smart Recipe
                                community.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-3">

                        <div class="step-card">

                            <div class="step-number">02</div>

                            <div class="step-icon">
                                <i class="fa-solid fa-compass"></i>
                            </div>

                            <h4>Discover Recipes</h4>

                            <p>
                                Search and explore delicious recipes from
                                our growing community.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-3">

                        <div class="step-card">

                            <div class="step-number">03</div>

                            <div class="step-icon">
                                <i class="fa-solid fa-heart"></i>
                            </div>

                            <h4>Save Favorites</h4>

                            <p>
                                Keep recipes you love close so they're
                                always ready when inspiration strikes.
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6 col-lg-3">

                        <div class="step-card">

                            <div class="step-number">04</div>

                            <div class="step-icon">
                                <i class="fa-solid fa-utensils"></i>
                            </div>

                            <h4>Cook & Enjoy</h4>

                            <p>
                                Follow the instructions, make something
                                amazing and enjoy every bite.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <section id="about" class="section-padding about-section">

            <div class="container">

                <div class="row align-items-center g-5">

                    <div class="col-lg-6">

                        <div class="about-image premium-about-image">

                            <img src="~/Images/Chef.jpg"
                                 alt="Chef preparing a delicious meal">

                            <div class="about-badge">

                                <i class="fa-solid fa-heart"></i>

                                <div>
                                    <strong>Made with passion</strong>
                                    <span>For food lovers</span>
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-lg-6">

                        <span class="section-label">
                            ABOUT SMART RECIPE
                        </span>

                        <h2 class="about-title">
                            Cooking is better
                            when we do it
                            <span>together.</span>
                        </h2>

                        <p class="about-text">
                            Smart Recipe Community is a modern home for
                            people who love food, cooking and discovering
                            new flavours.
                        </p>

